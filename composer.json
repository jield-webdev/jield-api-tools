{
  "name": "jield-webdev/jield-api-tools",
  "version": "0.0.1",
  "description": "Own implementation of API endpoints. This repository is based on the Laminas API tools but includes shared functionality to easily create API endpoints",
  "type": "library",
  "keywords": [
    "api",
    "module",
    "laminas"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jield-webdev/jield-api-tools",
  "authors": [
    {
      "name": "Johan van der Heide",
      "email": "info@jield.nl",
      "homepage": "https://jield.nl"
    }
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "bshaffer/oauth2-server-php": "^1.14.1",
    "laminas/laminas-mvc": "^3.8",
    "laminas/laminas-filter": "^2.40",
    "laminas/laminas-inputfilter": "^2.32",
    "laminas/laminas-validator": "^2.64",
    "laminas/laminas-paginator": "^2.19",
    "laminas/laminas-hydrator": "^4.16",
    "laminas/laminas-config-aggregator": "^1.18",
    "laminas/laminas-authentication": "^2.18",
    "laminas/laminas-permissions-rbac": "^3.7",
    "solarium/solarium": "dev-master",
    "jield-webdev/jield-authorize": "^2.1",
    "webmozart/assert": "^1.11",
    "lm-commons/lmc-cors": "^1.5",
    "psr/link": "^2.0",
    "zircote/swagger-php": "^5",
    "swagger-api/swagger-ui": "^5.20",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "iteaoffice/testing": "^5.1"
  },
  "autoload": {
    "psr-4": {
      "Jield\\ApiTools\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jield\\ApiToolsTest\\": "test"
    }
  },
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/package-versions-deprecated": true
    }
  },
  "extra": {
    "laminas": {
      "module": "Jield\\ApiTools\\Module"
    },
    "branch-alias": {
      "dev-main": "1.0-dev",
      "dev-develop": "1.1-dev"
    }
  },
  "scripts": {
    "check": [
      "@php-lint",
      "@phpstan",
      "@cs",
      "@test"
    ],
    "fix": [
      "@cbf",
      "@cs-fix"
    ],
    "php-lint": "./vendor/bin/parallel-lint src",
    "phpstan": "./vendor/bin/phpstan --memory-limit=2G",
    "cs": "./vendor/bin/phpcs -n -p --standard=PSR2 --extensions=php src",
    "cbf": "./vendor/bin/phpcbf src --standard=PSR2",
    "cs-fix": "./vendor/bin/php-cs-fixer fix -v src",
    "test": "./vendor/bin/phpunit"
  }
}
