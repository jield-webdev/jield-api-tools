{
  "name": "jield-webdev/jield-api-tools",
  "description": "Own implementation of API endpoints. This repository is based on the Laminas API tools but includes shared functionality to easily create API endpoints",
  "type": "library",
  "keywords": [
    "api",
    "module",
    "laminas"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jield-webdev/jield-api-tools",
  "authors": [
    {
      "name": "Johan van der Heide",
      "email": "info@jield.nl",
      "homepage": "https://jield.nl"
    }
  ],
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "bshaffer/oauth2-server-php": "^1.14.2",
    "laminas/laminas-mvc": "^3.8",
    "laminas/laminas-filter": "^2.42",
    "laminas/laminas-inputfilter": "^2.35",
    "laminas/laminas-validator": "^2.65",
    "laminas/laminas-paginator": "^2.22",
    "laminas/laminas-hydrator": "^4.19",
    "laminas/laminas-config-aggregator": "^1.20",
    "laminas/laminas-authentication": "^2.19",
    "laminas/laminas-permissions-rbac": "^3.8",
    "solarium/solarium": "dev-master",
    "jield-webdev/jield-authorize": "^2.1",
    "webmozart/assert": "^1.12",
    "lm-commons/lmc-cors": "^1.6",
    "psr/link": "^2.0",
    "zircote/swagger-php": "^5 || ^6",
    "swagger-api/swagger-ui": "^5.34",
    "ext-fileinfo": "*",
    "firebase/php-jwt": "^7.2",
    "guzzlehttp/guzzle": "^7",
    "symfony/cache": "^5.4 || ^6 || ^7",
    "symfony/finder": "^5.4 || ^6 || ^7",
    "psr/cache": "^1 || ^2 || ^3",
    "ext-openssl": "*"
  },
  "require-dev": {
    "iteaoffice/testing": "^5.1"
  },
  "autoload": {
    "psr-4": {
      "Jield\\ApiTools\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jield\\ApiToolsTest\\": "test"
    }
  },
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/package-versions-deprecated": true
    }
  },
  "extra": {
    "laminas": {
      "module": "Jield\\ApiTools\\Module"
    }
  },
  "scripts": {
    "check": [
      "@php-lint",
      "@phpstan",
      "@cs",
      "@test"
    ],
    "fix": [
      "@cbf",
      "@cs-fix"
    ],
    "php-lint": "./vendor/bin/parallel-lint src",
    "phpstan": "./vendor/bin/phpstan --memory-limit=2G",
    "cs": "./vendor/bin/phpcs -n -p --standard=PSR2 --extensions=php src",
    "cbf": "./vendor/bin/phpcbf src --standard=PSR2",
    "cs-fix": "./vendor/bin/php-cs-fixer fix -v src",
    "test": "./vendor/bin/phpunit"
  }
}
